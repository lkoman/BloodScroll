<?xml version="1.0" encoding="utf-8"?>
<TextureAtlas imagePath="flower.png">
	<Texture>images/flower</Texture>
	<Regions>
		<SubTexture name="Flower_face" x="0" y="0" width="67" height="68" frameX="2" frameY="2" frameWidth="64" frameHeight="64"/>
		<SubTexture name="flower_stem" x="97" y="36" width="8" height="12" frameX="2" frameY="2" frameWidth="4" frameHeight="8"/>
		<SubTexture name="Flower_idle" x="67" y="36" width="30" height="26" frameX="-16" frameY="-8" frameWidth="64" frameHeight="32"/>
		<SubTexture name="Flower_leaves" x="67" y="0" width="63" height="36" frameX="-2" frameY="2" frameWidth="64" frameHeight="32"/>
	</Regions>
	<Animations>
		<!--
			THE FLOWER, IN FOUR ANIMATIONS

			The code only ever asks for these four names (see MobArt.cs), so
			adding frames is done HERE and nothing in the code changes:
			draw the frame, give it a SubTexture above, add a <Frame> line.

			flower-sleeping and flower-bite are still pointing at the idle
			face because those drawings do not exist yet.
		-->

		<!-- Curled up on the platform, before the player comes near -->
		<Animation name="flower-sleeping" delay="250">
			<Frame region="Flower_idle" />
		</Animation>

		<!-- Awake, swaying on the stalk -->
		<Animation name="flower-idle" delay="200">
			<Frame region="Flower_face" />
		</Animation>

		<!-- Jaws open, thrown out at the player. Wants to be fast - keep the
		     delay short so the bite reads inside the third of a second it is
		     actually out there. -->
		<Animation name="flower-bite" delay="80">
			<Frame region="Flower_face" />
		</Animation>

		<!-- The root on the platform. The head is tied to this and it never
		     moves, so a single frame is fine unless you want it breathing. -->
		<Animation name="flower-leaves" delay="250">
			<Frame region="Flower_leaves" />
		</Animation>

		<!-- ONE piece of stalk. It is repeated from the leaves up to the head,
		     as many times as the stalk is long, so this is the only stem
		     drawing needed at any length. Draw it upright, growing UPWARDS,
		     with the joining end at the bottom of the frame. -->
		<Animation name="flower-stem" delay="250">
			<Frame region="flower_stem" />
		</Animation>
	</Animations>
</TextureAtlas>
